cabal-version:      2.4
name:               adventure
version:            0.1.0.0
synopsis:           A storybook text adventure narrated by a local LLM via Ollama
build-type:         Simple

executable adventure
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:    State
                    World
                    Engine
                    Prompt
                    Llm
  build-depends:    base         >=4.14 && <5
                  , aeson        >=2.0
                  , bytestring
                  , containers
                  , http-client
                  , http-types
                  , text
  default-language: Haskell2010
  ghc-options:      -Wall -threaded
